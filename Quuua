    RunService.Stepped:Connect(function()
        if _G.AntiPush and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
    end)
end)

CreateToggle("Fling Push (При касании)", function(v)
