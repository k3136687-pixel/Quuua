local activeTabContainer = nil

local function UpdateThemeColor(newColor)
    _G.CurrentAccent = newColor
    for _, el in ipairs(_G.InteractiveElements) do
        if el and el.Parent then
            if el:IsA("UIStroke") then
                el.Color = newColor
            else
                el.BackgroundColor3 = newColor
            end
        end
    end
end

-- RGB цикл
task.spawn(function()
    local hue = 0
    while true do
        if _G.isRGB then
            hue = (hue + 0.004) % 1
            UpdateThemeColor(Color3.fromHSV(hue, 1, 1))
        end
        task.wait(0.03)
    end
end)

function CreateTab(name)
    local tabBtn = Instance.new("TextButton", Sidebar)
    tabBtn.Size = UDim2.new(1, -4, 0, 34)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = "  " .. name
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 165)
    tabBtn.TextSize = 11
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left

    local container = Instance.new("ScrollingFrame", ContentArea)
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.ScrollBarThickness = 3
    container.Visible = false

    local list = Instance.new("UIListLayout", container)
    list.Padding = UDim.new(0, 6)
    list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        container.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 10)
    end)

    tabBtn.MouseButton1Click:Connect(function()
        for _, c in pairs(ContentArea:GetChildren()) do if c:IsA("ScrollingFrame") then c.Visible = false end end
        for _, b in pairs(Sidebar:GetChildren()) do if b:IsA("TextButton") then b.TextColor3 = Color3.fromRGB(150, 150, 165) end end
        container.Visible = true
        tabBtn.TextColor3 = _G.CurrentAccent
    end)

    if not activeTabContainer then
        activeTabContainer = container
        container.Visible = true
        tabBtn.TextColor3 = _G.CurrentAccent
    end

    return container
end

function CreateToggle(parent, title, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, -6, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    btn.Text = "  " .. title
    btn.TextColor3 = Color3.fromRGB(220, 220, 235)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local statusBox = Instance.new("TextLabel", btn)
    statusBox.Size = UDim2.new(0, 42, 0, 22)
    statusBox.Position = UDim2.new(1, -48, 0.5, -11)
    statusBox.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
    statusBox.Text = "OFF"
    statusBox.TextColor3 = Color3.fromRGB(130, 130, 145)
    statusBox.TextSize = 10
    statusBox.Font = Enum.Font.GothamBold
    Instance.new("UICorner", statusBox).CornerRadius = UDim.new(0, 6)

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        statusBox.Text = state and "ON" or "OFF"
        statusBox.TextColor3 = state and Color3.new(1,1,1) or Color3.fromRGB(130, 130, 145)
        statusBox.BackgroundColor3 = state and _G.CurrentAccent or Color3.fromRGB(16, 16, 22)
        if state then table.insert(_G.InteractiveElements, statusBox) end
        callback(state)
    end)
end
