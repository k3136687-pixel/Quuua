-- 1. Anti Ragdoll
CreateToggle("Anti Ragdoll", function(v)
    _G.AntiRagdoll = v
    task.spawn(function()
        while _G.AntiRagdoll do
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.PlatformStanding = false
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root and root.AssemblyLinearVelocity.Y < -40 then
                            root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
                        end
                    end
                end
            end)
            task.wait(0.05)
        end
    end)
end)

-- 2. Push Troll
CreateToggle("Push Troll", function(v)
    _G.PushTroll = v
    task.spawn(function()
        while _G.PushTroll do
            pcall(function()
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local pRoot = p.Character.HumanoidRootPart
                            if (root.Position - pRoot.Position).Magnitude < 7 then
                                pRoot.AssemblyLinearVelocity = (pRoot.Position - root.Position).Unit * 150 + Vector3.new(0, 50, 0)
                            end
                        end
                    end
                end
            end)
            task.wait(0.1)
        end
    end)
end)

