-- Quuua-Hub v1.0 (Part 2: Core Functions & Mobile Fly)
task.spawn(function()
    while not getgenv().ContainerMain or not getgenv().QuuuaScreenGui do
        task.wait(0.1)
    end

    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")
    local Lighting = game:GetService("Lighting")
    local VirtualUser = game:GetService("VirtualUser")
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local CoreGui = game:GetService("CoreGui")
    local LocalPlayer = Players.LocalPlayer

    local ScreenGui = getgenv().QuuuaScreenGui
    local ContainerMain = getgenv().ContainerMain
    local ContainerCustom = getgenv().ContainerCustom

    local yOffset = 5
    local function createToggle(parent, name, callback)
        local btn = Instance.new("TextButton")
        btn.Parent = parent
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        btn.BorderColor3 = Color3.fromRGB(60, 60, 60)
        btn.Position = UDim2.new(0, 5, 0, yOffset)
        btn.Size = UDim2.new(1, -10, 0, 35)
        btn.Font = Enum.Font.SourceSansBold
        btn.Text = "  " .. name .. " [OFF]"
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.TextSize = 14
        btn.TextXAlignment = Enum.TextXAlignment.Left
        
        local active = false
        btn.MouseButton1Click:Connect(function()
            active = not active
            if active then
                btn.BackgroundColor3 = Color3.fromRGB(0, 80, 40)
                btn.BorderColor3 = Color3.fromRGB(0, 255, 128)
                btn.Text = "  " .. name .. " [ON]"
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                btn.BorderColor3 = Color3.fromRGB(60, 60, 60)
                btn.Text = "  " .. name .. " [OFF]"
                btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
            callback(active)
        end)
        yOffset = yOffset + 40
    end

    local function createSlider(parent, name, min, max, default, callback)
        local frame = Instance.new("Frame")
        frame.Parent = parent
        frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        frame.BorderColor3 = Color3.fromRGB(50, 50, 50)
        frame.Position = UDim2.new(0, 5, 0, yOffset)
        frame.Size = UDim2.new(1, -10, 0, 45)
        
        local label = Instance.new("TextLabel")
        label.Parent = frame
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 5, 0, 2)
        label.Size = UDim2.new(1, -10, 0, 20)
        label.Font = Enum.Font.SourceSansBold
        label.Text = name .. ": " .. default
        label.TextColor3 = Color3.fromRGB(220, 220, 220)
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        
        local sliderBg = Instance.new("TextButton")
        sliderBg.Parent = frame
        sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        sliderBg.BorderSizePixel = 0
        sliderBg.Position = UDim2.new(0, 5, 0, 25)
        sliderBg.Size = UDim2.new(1, -10, 0, 12)
        sliderBg.Text = ""
        
        local sliderFill = Instance.new("Frame")
        sliderFill.Parent = sliderBg
        sliderFill.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
        sliderFill.BorderSizePixel = 0
        sliderFill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
        
        local draggingSlider = false
        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                sliderFill.Size = UDim2.new(pos, 0, 1, 0)
                local val = math.floor(min + (max - min) * pos)
                label.Text = name .. ": " .. val
                callback(val)
            end
        end)
        yOffset = yOffset + 50
    end

    -- 1. ESP Box
    createToggle(ContainerMain, "ESP Box", function(state)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if state then
                    if not p.Character:FindFirstChild("ESPHighlight") then
                        local hl = Instance.new("Highlight", p.Character)
                        hl.Name = "ESPHighlight"
                        hl.FillColor = Color3.fromRGB(0, 255, 128)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    end
                else
                    if p.Character:FindFirstChild("ESPHighlight") then p.Character.ESPHighlight:Destroy() end
                end
            end
        end
    end)

    -- 2. Auto-Clicker
    local autoClicking = false
    task.spawn(function()
        while true do
            task.wait(0.1)
            if autoClicking then
                VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                task.wait(0.05)
                VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            end
        end
    end)
    createToggle(ContainerMain, "Auto-Clicker", function(state) autoClicking = state end)

    -- 3. Infinite Jump
    local infJumpConn
    createToggle(ContainerMain, "Infinite Jump", function(state)
        if state then
            infJumpConn = UserInputService.JumpRequest:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end
            end)
        else
            if infJumpConn then infJumpConn:Disconnect() end
        end
    end)

    -- 4. Fullbright
    createToggle(ContainerMain, "Fullbright", function(state)
        Lighting.Brightness = state and 2 or 1
        Lighting.GlobalShadows = not state
    end)
    createSlider(ContainerMain, "Fullbright Brightness", 1, 10, 2, function(val)
        Lighting.Brightness = val
    end)

    -- 5. Personal Teleport
    local tpPos = nil
    local markerPart = nil
    local tpConn = nil

    createToggle(ContainerMain, "Personal Teleport", function(state)
        if state then
            tpConn = UserInputService.InputBegan:Connect(function(input, gpe)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if gpe then return end
                    
                    local cam = workspace.CurrentCamera
                    local mousePos = UserInputService:GetMouseLocation()
                    local unitRay = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                    
                    local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
                    if result then
                        tpPos = result.Position + Vector3.new(0, 3, 0)
                        
                        if markerPart then markerPart:Destroy() end
                        markerPart = Instance.new("Part")
                        markerPart.Size = Vector3.new(1, 1, 1)
                        markerPart.Shape = Enum.PartType.Ball
                        markerPart.Material = Enum.Material.Neon
                        markerPart.Color = Color3.fromRGB(0, 255, 128)
                        markerPart.Anchored = true
                        markerPart.CanCollide = false
                        markerPart.Position = tpPos
                        markerPart.Parent = workspace
                    end
                end
            end)

            local lastJumpState = false
            task.spawn(function()
                while state and task.wait(0.1) do
                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if hum and root and tpPos then
                            if hum.Jump and not lastJumpState then
                                root.CFrame = CFrame.new(tpPos)
                            end
                            lastJumpState = hum.Jump
                        end
                    end
                end
            end)
        else
            if tpConn then tpConn:Disconnect() end
            if markerPart then markerPart:Destroy() end
            tpPos = nil
        end
    end)

    -- 6. Player List GUI
    local playerListFrame = Instance.new("ScrollingFrame")
    playerListFrame.Parent = ScreenGui
    playerListFrame.BackgroundTransparency = 0.3
    playerListFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    playerListFrame.BorderColor3 = Color3.fromRGB(0, 255, 128)
    playerListFrame.Position = UDim2.new(1, -180, 0.4, 0)
    playerListFrame.Size = UDim2.new(0, 170, 0, 200)
    playerListFrame.CanvasSize = UDim2.new(0, 0, 0, 500)
    playerListFrame.Visible = false
    playerListFrame.ScrollBarThickness = 3

    createToggle(ContainerMain, "Player List GUI", function(state)
        playerListFrame.Visible = state
    end)

    task.spawn(function()
        while true do
            task.wait(1)
            if playerListFrame.Visible then
                for _, child in ipairs(playerListFrame:GetChildren()) do
                    if child:IsA("TextLabel") then child:Destroy() end
                end
                local yPos = 2
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local distTxt = "Далеко"
                        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            distTxt = math.floor(dist) .. "m"
                        end
                        local lbl = Instance.new("TextLabel")
                        lbl.Parent = playerListFrame
                        lbl.BackgroundTransparency = 1
                        lbl.Position = UDim2.new(0, 5, 0, yPos)
                        lbl.Size = UDim2.new(1, -10, 0, 20)
                        lbl.Font = Enum.Font.SourceSansBold
                        lbl.Text = p.Name .. " [" .. distTxt .. "]"
                        lbl.TextColor3 = Color3.fromRGB(0, 255, 128)
                        lbl.TextSize = 12
                        lbl.TextXAlignment = Enum.TextXAlignment.Left
                        yPos = yPos + 22
                    end
                end
            end
        end
    end)

    -- 7. FPS & Ping Counter
    local fpsLabel = Instance.new("TextLabel")
    fpsLabel.Parent = ScreenGui
    fpsLabel.BackgroundTransparency = 0.5
    fpsLabel.BackgroundColor3 = Color3.fromRGB(0,0,0)
    fpsLabel.Position = UDim2.new(0, 10, 0, 10)
    fpsLabel.Size = UDim2.new(0, 120, 0, 25)
    fpsLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
    fpsLabel.TextSize = 14
    fpsLabel.Visible = false
    RunService.RenderStepped:Connect(function(dt)
        if fpsLabel.Visible then
            local fps = math.floor(1/dt)
            local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            fpsLabel.Text = "FPS: " .. fps .. " | Ping: " .. ping .. "ms"
        end
    end)
    createToggle(ContainerMain, "FPS & Ping Counter", function(state) fpsLabel.Visible = state end)

    -- 8. Speed
    local currentSpeed = 16
    createToggle(ContainerMain, "Speed Boost", function(state)
        task.spawn(function()
            while state and task.wait(0.2) do
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                    LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = currentSpeed
                end
            end
            if not state and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
            end
        end)
    end)
    createSlider(ContainerMain, "Speed Value", 16, 150, 32, function(val) currentSpeed = val end)

    -- 9. Fly
    local flying = false
    local flySpeed = 50
    local flyVertical = 0
    local bv, bg, flyConn

    local FlyGui = Instance.new("ScreenGui")
    FlyGui.Name = "FlyGuiPanel"
    FlyGui.Parent = CoreGui
    FlyGui.Enabled = false

    local FlyFrame = Instance.new("Frame")
    FlyFrame.Parent = FlyGui
    FlyFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    FlyFrame.BorderColor3 = Color3.fromRGB(120, 0, 255)
    FlyFrame.Position = UDim2.new(0, 30, 0, 150)
    FlyFrame.Size = UDim2.new(0, 180, 0, 90)
    FlyFrame.Active = true
    FlyFrame.Draggable = true

    local BtnUp = Instance.new("TextButton")
    BtnUp.Parent = FlyFrame
    BtnUp.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    BtnUp.Position = UDim2.new(0, 5, 0, 5)
    BtnUp.Size = UDim2.new(0, 50, 0, 35)
    BtnUp.Text = "UP"
    BtnUp.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnUp.Font = Enum.Font.SourceSansBold

    local BtnDown = Instance.new("TextButton")
    BtnDown.Parent = FlyFrame
    BtnDown.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    BtnDown.Position = UDim2.new(0, 5, 0, 45)
    BtnDown.Size = UDim2.new(0, 50, 0, 35)
    BtnDown.Text = "DOWN"
    BtnDown.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnDown.Font = Enum.Font.SourceSansBold

    local BtnSpeedPlus = Instance.new("TextButton")
    BtnSpeedPlus.Parent = FlyFrame
    BtnSpeedPlus.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    BtnSpeedPlus.Position = UDim2.new(0, 60, 0, 5)
    BtnSpeedPlus.Size = UDim2.new(0, 35, 0, 35)
    BtnSpeedPlus.Text = "+"
    BtnSpeedPlus.TextColor3 = Color3.fromRGB(255, 255, 255)

    local BtnSpeedMinus = Instance.new("TextButton")
    BtnSpeedMinus.Parent = FlyFrame
    BtnSpeedMinus.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    BtnSpeedMinus.Position = UDim2.new(0, 60, 0, 45)
    BtnSpeedMinus.Size = UDim2.new(0, 35, 0, 35)
    BtnSpeedMinus.Text = "-"
    BtnSpeedMinus.TextColor3 = Color3.fromRGB(255, 255, 255)

    local LblFlyInfo = Instance.new("TextButton")
    LblFlyInfo.Parent = FlyFrame
    LblFlyInfo.BackgroundColor3 = Color3.fromRGB(255, 0, 128)
    LblFlyInfo.Position = UDim2.new(0, 100, 0, 5)
    LblFlyInfo.Size = UDim2.new(0, 75, 0, 35)
    LblFlyInfo.Text = "FLY V3"
    LblFlyInfo.TextColor3 = Color3.fromRGB(255, 255, 255)
    LblFlyInfo.Font = Enum.Font.SourceSansBold

    local BtnCloseFly = Instance.new("TextButton")
    BtnCloseFly.Parent = FlyFrame
    BtnCloseFly.BackgroundColor3 = Color3.fromRGB(255, 220, 0)
    BtnCloseFly.Position = UDim2.new(0, 100, 0, 45)
    BtnCloseFly.Size = UDim2.new(0, 75, 0, 35)
    BtnCloseFly.Text = "off"
    BtnCloseFly.TextColor3 = Color3.fromRGB(0, 0, 0)
    BtnCloseFly.Font = Enum.Font.SourceSansBold

    BtnUp.MouseButton1Down:Connect(function() flyVertical = 50 end)
    BtnUp.MouseButton1Up:Connect(function() flyVertical = 0 end)
    BtnDown.MouseButton1Down:Connect(function() flyVertical = -50 end)
    BtnDown.MouseButton1Up:Connect(function() flyVertical = 0 end)

    BtnSpeedPlus.MouseButton1Click:Connect(function() flySpeed = flySpeed + 10 LblFlyInfo.Text = "Spd:"..flySpeed end)
    BtnSpeedMinus.MouseButton1Click:Connect(function() flySpeed = math.clamp(flySpeed - 10, 10, 300) LblFlyInfo.Text = "Spd:"..flySpeed end)

    createToggle(ContainerMain, "Fly", function(state)
        flying = state
        FlyGui.Enabled = state
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        if flying then
            local rootPart = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            bv = Instance.new("BodyVelocity", rootPart)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bg = Instance.new("BodyGyro", rootPart)
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            
            flyConn = RunService.RenderStepped:Connect(function()
                local cam = Workspace.CurrentCamera
                local moveDir = Vector3.new(0,0,0)
                
                if hum then
                    moveDir = hum.MoveDirection
                end
                
                bv.Velocity = (moveDir * flySpeed) + Vector3.new(0, flyVertical, 0)
                bg.CFrame = cam.CFrame
            end)
        else
            if flyConn then flyConn:Disconnect() end
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
        end
    end)

    BtnCloseFly.MouseButton1Click:Connect(function()
        flying = false
        FlyGui.Enabled = false
        if flyConn then flyConn:Disconnect() end
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end)

    createSlider(ContainerMain, "Fly Speed", 20, 200, 50, function(val) flySpeed = val end)
end)
