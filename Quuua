CreateToggle(TabMain, "Push Troll", function(v)
    _G.PushTroll = v
    task.spawn(function()
        while _G.PushTroll do
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            if (root.Position - p.Character.HumanoidRootPart.Position).Magnitude < 6 then
                                p.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 150, 0)
                            end
                        end
                    end
                end
            end)
            task.wait(0.2)
        end
    end)
end)

