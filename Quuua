local skyRunning = false
createToggle(ContainerCustom, "Rainbow Sky Mode", function(state)
    skyRunning = state
    task.spawn(function()
        local hue = 0
        while skyRunning do
            hue = (hue + 1) % 360
            Lighting.Ambient = Color3.fromHSV(hue/360, 1, 1)
            task.wait(0.1)
        end
        Lighting.Ambient = Color3.fromRGB(128,128,128)
    end)
end)
